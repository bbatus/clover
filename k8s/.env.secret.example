# =============================================================================
# k8s/.env.secret ŞABLONU — cp k8s/.env.secret.example k8s/.env.secret
# .env.secret .gitignore'dadır — GERÇEK DEĞERLERİ ORAYA yazın, buraya DEĞİL.
# =============================================================================

# --- PostgreSQL (docs/OCP-DEVOPS-RUNBOOK.md §3) -----------------------------
# TNS: 172.31.229.152:5432/vpaycms_test_new, kullanıcı vpaycmstest_new_user
# ⚠️ DBA'dan gelen parola kullanıcı adıyla aynı görünüyordu — production'a
#    geçmeden mutlaka teyit edin/değiştirin.
DATABASE_URI=postgres://vpaycmstest_new_user:CHANGE_ME@172.31.229.152:5432/vpaycms_test_new

# --- Uygulama sırları — mevcut yerel .env'den taşınabilir (aynı değerler
#     REVALIDATE_SECRET/PREVIEW_SECRET için site tarafındaki secret ile
#     BİREBİR AYNI olmalı, ikisi de aynı webhook'u imzalıyor/doğruluyor) ----
PAYLOAD_SECRET=
REVALIDATE_SECRET=
PREVIEW_SECRET=

# --- CMS admin (LDAP bağlanana kadar, S8) -----------------------------------
CMS_ADMIN_EMAIL=admin@vodafonepay.local
CMS_ADMIN_PASSWORD=

# --- OPSİYONEL (boş bırakılırsa script rastgele üretir) --------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- OPSİYONEL: hedef namespace ---------------------------------------------
OCP_NAMESPACE=vepas-ai-am
